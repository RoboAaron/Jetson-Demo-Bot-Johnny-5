+// Parse and apply a Jetson motion command: #VEL=<m/s>,STEER=<rad/s>
+// Called from the serial loop when the next byte is '#'.
+void handleJetsonCommand(String line) {
+  if (!line.startsWith("#VEL=")) return;
+  int steerIdx = line.indexOf(",STEER=");
+  if (steerIdx < 0) return;
+  float newVel   = line.substring(5, steerIdx).toFloat();
+  float newSteer = line.substring(steerIdx + 7).toFloat();
+  velocitySetpoint = constrain(newVel,   -JETSON_MAX_VEL_MPS,    JETSON_MAX_VEL_MPS);
+  jetsonSteerRads  = constrain(newSteer, -JETSON_MAX_STEER_RADS, JETSON_MAX_STEER_RADS);
+  lastJetsonMs     = millis();
+}
