Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
    - Class: rviz_default_plugins/LaserScan
      Topic:
        Value: /scan
      Enabled: true
      Name: LaserScan
      Size (m): 0.03
      Color Transformer: Intensity
    - Class: rviz_default_plugins/Image
      Topic:
        Value: /camera/image_raw
      Enabled: false
      Name: Camera
    - Class: rviz_default_plugins/Imu
      Topic:
        Value: /imu/data
      Enabled: true
      Name: IMU
      Box Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Topic:
        Value: /map
      Enabled: true
      Name: Map
    - Class: rviz_default_plugins/Path
      Topic:
        Value: /plan
      Enabled: true
      Name: GlobalPath
      Line Style: Lines
      Color: 0; 255; 0
    - Class: rviz_default_plugins/Odometry
      Topic:
        Value: /odom
      Enabled: true
      Name: Odometry
      Keep: 100
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 3.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: ThirdPersonFollower
      Pitch: 0.5
      Target Frame: base_link
      Yaw: 3.14
Window Geometry:
  Height: 800
  Width: 1200
